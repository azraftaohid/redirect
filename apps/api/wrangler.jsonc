{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "redirect-prod",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_TOKENS"
    }
  ],
  "ratelimits": [
    {
      "name": "CLICK_LIMITER",
      "namespace_id": "84021001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "84021002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
