{
  "name": "@redirect/api",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-assets.mjs",
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "pretypecheck": "node scripts/ensure-assets.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-assets.mjs",
    "test": "vitest run",
    "predeploy": "node scripts/verify-dist.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@redirect/shared": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
